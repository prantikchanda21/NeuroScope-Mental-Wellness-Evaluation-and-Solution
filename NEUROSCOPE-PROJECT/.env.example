# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional for Groq Llama assessment fallback/provider
GROQ_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# VITE_GOOGLE_CLIENT_ID: OAuth client ID for the "Sign in with Google" button
# on the login page. Create one at https://console.cloud.google.com/apis/credentials
# (type: "OAuth client ID" -> "Web application"), add your dev/prod URLs under
# "Authorized JavaScript origins", and paste the client ID below. Must be
# prefixed with VITE_ so Vite exposes it to the browser bundle. Without it,
# email/password sign-in still works fine — the Google button just shows a
# "not configured" note instead.
VITE_GOOGLE_CLIENT_ID=""

# Optional translation tuning
# TRANSLATE_MODELS: comma-separated Gemini models tried in order (the first that works is remembered).
# TRANSLATE_MODELS="gemini-3.8-flash,gemini-2.5-flash,gemini-flash-latest"
# TRANSLATION_CACHE_DIR: where the shared translation cache is stored (default: OS temp dir).
# TRANSLATION_CACHE_DIR="./.translation-cache"
